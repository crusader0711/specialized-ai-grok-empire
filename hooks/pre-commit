#!/usr/bin/env bash
# pre-commit: PII scan on staged lines, then lint + secret scan (gitleaks if installed).
set -euo pipefail
./scripts/pii-scan.sh --staged || { echo "pre-commit: blocked by PII guard (see config/pii-allowlist.txt for reviewed false positives)"; exit 1; }
./scripts/lint.sh
if command -v gitleaks >/dev/null; then gitleaks protect --staged --no-banner; fi
